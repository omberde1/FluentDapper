<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>FluentDapper</id>
    <version>2.0.2</version>

    <title>FluentDapper</title>

    <authors>OmBerde</authors>
    <owners>OmBerde</owners>

    <requireLicenseAcceptance>false</requireLicenseAcceptance>

    <license type="expression">MIT</license>

    <projectUrl>https://github.com/omberde1/FluentDapper</projectUrl>

    <repository type="git" url="https://github.com/omberde1/FluentDapper" />

    <description>
      A simple, fluent wrapper over Dapper for .NET Framework developers.
    </description>

    <releaseNotes>
      Fixed dependency packaging and runtime compatibility issues.
    </releaseNotes>

    <tags>
      dapper sql orm fluent database .net framework
    </tags>

    <dependencies>
      <group targetFramework=".NETFramework4.7.2">

        <dependency id="Dapper" version="2.1.72" />

        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="9.0.1" />

        <dependency id="System.Runtime.CompilerServices.Unsafe" version="4.5.3" />

        <dependency id="System.Threading.Tasks.Extensions" version="4.5.4" />

      </group>
    </dependencies>

  </metadata>

  <files>
    <file src="bin\Release\FluentDapper.dll" target="lib\net472\" />
    <file src="bin\Release\FluentDapper.pdb" target="lib\net472\" />
  </files>
</package>